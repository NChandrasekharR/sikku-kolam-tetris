{
  "name": "kolam-tetris-video",
  "version": "1.0.0",
  "description": "Sikku Kolam Tetris gameplay video",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/fonts": "4.0.536",
    "@remotion/media": "4.0.536",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.536",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "audio": "tsx scripts/render-audio.ts",
    "seeds": "tsx scripts/search-seeds.ts",
    "render": "npm run audio && remotion render KolamTetris out/kolam-tetris.mp4 --codec=h264 --crf=16 --jpeg-quality=95 --audio-bitrate=256k",
    "diagram": "remotion still WeaveDiagram out/weave-diagram.png",
    "card": "remotion still OgCard out/og-card@2x.png",
    "share-audio": "tsx scripts/render-share-audio.ts",
    "share": "npm run share-audio && remotion render ShareStory out/share-story.mp4 --codec=h264 --crf=16 --jpeg-quality=95 --audio-bitrate=256k"
  },
  "allowScripts": {
    "esbuild": false
  }
}
